# Server (server/.env or host environment variables)
PORT=3001
# Comma-separated list of allowed client origins when the client is hosted separately.
CLIENT_ORIGIN=https://playbeerpong.online
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Client build (client/.env). Leave empty when the server also serves the client.
VITE_SERVER_URL=
